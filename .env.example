# Shortfin UI — environment variables
# Copy to .env for local dev; set in Vercel Project Settings -> Environment Variables for deploys.

# REQUIRED on Vercel: origin the Next.js rewrites proxy /api/* + /health to (the brain API).
# Must be publicly reachable from Vercel's servers. Local dev keeps the default.
# Vercel value: https://openclaw.117aub.online/brain-api
API_ORIGIN=http://127.0.0.1:8890

# OPTIONAL escape hatch: absolute API base for the browser (skips the same-origin
# rewrites). Leave unset in production — rewrites handle everything without CORS.
# NEXT_PUBLIC_API_URL=

# NOTE — no base-path var needed: the app auto-detects Vercel (root domain) vs
# gateway deploys (/platform subpath). No token belongs in this file: the desk
# token is entered once in the UI per browser (localStorage).
